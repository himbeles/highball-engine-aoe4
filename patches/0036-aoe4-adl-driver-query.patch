+/* LGPL-2.1-or-later. Uses the same verified-image and opt-in boundary as 0032. */
+#ifndef HIGHBALL_AOE_DRIVER_COMPAT_H
+#define HIGHBALL_AOE_DRIVER_COMPAT_H
+#include "aoe_build_guard.h"
+
+static int aoe_driver_compat_allowed(int verified, const char *image)
+{
+    const char *disabled = getenv("HB_AOE4_ADL");
+    return verified && aoe_patch_requested() && aoe_game_name(image) &&
+           (!disabled || strcmp(disabled, "0"));
+}
+#endif
