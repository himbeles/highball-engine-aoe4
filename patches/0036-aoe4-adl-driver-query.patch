+#if defined(__APPLE__) && defined(__x86_64__)
+/* The private DLL directory is process-local. It never enters the environment
+ * or the prefix registry, so a child or another game does not inherit it. */
+static void aoe_install_driver_path(const char *image)
+{
+    static BOOL added;
+    char *root, *path, *library;
+    struct stat st;
+
+    if (added || !aoe_driver_compat_allowed(aoe_game_verified, image)) return;
+    if (!(root = remove_tail(ntdll_dir, "/lib/wine/x86_64-unix"))) return;
+    path = build_path(root, "share/wine/aoe4/driver-compat");
+    free(root);
+    library = build_path(path, "x86_64-windows/atiadlxx.dll");
+    if (stat(library, &st) || !S_ISREG(st.st_mode))
+    {
+        WARN("AoE4 ADL compatibility library unavailable at %s; keeping the normal driver check\n", library);
+        free(library);
+        free(path);
+        return;
+    }
+    aoe_driver_library = library;
+    prepend_dll_path(path); /* owns path for the lifetime of this process */
+    added = TRUE;
+    ERR("AoE4 ADL driver compatibility enabled for the verified executable\n");
+}
+#endif
 
 static void set_dll_path(void)
 {
@@ -1565,6 +1598,26 @@
 #ifdef __x86_64__
 extern NTSTATUS aoe_exception_context(void *args);
 #endif
+#ifdef __x86_64__
+/* Resolve only the process-local module selected after executable verification.
+ * No search path or override is written to the prefix or inherited environment. */
+static NTSTATUS aoe_driver_path(void *args)
+{
+    struct aoe_driver_path_params *params = args;
+    WCHAR *name;
+    size_t length;
+    NTSTATUS status;
+
+    if (!aoe_game_verified || !aoe_driver_library) return STATUS_DLL_NOT_FOUND;
+    if ((status = unix_to_nt_file_name(aoe_driver_library, &name, FILE_OPEN))) return status;
+    length = wcslen(name) + 1;
+    if (length > params->capacity) status = STATUS_BUFFER_TOO_SMALL;
+    else memcpy(params->buffer, name, length * sizeof(WCHAR));
+    free(name);
+    return status;
+}
+#endif
