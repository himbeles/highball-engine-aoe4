diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -3752,6 +3752,28 @@
 
     if (contains_path( name )) return status;
 
+#ifdef __x86_64__
+    /* AoE IV's private ADL builtin has no prefix placeholder. The Unix side
+     * exposes it only after the actual executable passes the AoE build guard. */
+    if (!wcsicmp(name, L"atiadlxx.dll"))
+    {
+        struct aoe_driver_path_params params;
+        params.capacity = 32767;
+        params.buffer = RtlAllocateHeap(GetProcessHeap(), 0, params.capacity * sizeof(WCHAR));
+        if (!params.buffer) return STATUS_NO_MEMORY;
+        status = WINE_UNIX_CALL(unix_aoe_driver_path, &params);
+        if (!status)
+        {
+            RtlInitUnicodeString(new_name, params.buffer);
+            status = open_dll_file(new_name, pwm, mapping, image_info, id);
+            if (!status) return status;
+        }
+        RtlFreeHeap(GetProcessHeap(), 0, params.buffer);
+        new_name->Buffer = NULL;
+        status = STATUS_DLL_NOT_FOUND;
+    }
+#endif
