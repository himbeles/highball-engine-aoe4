+#if defined(__APPLE__) && defined(__x86_64__)
+/* Re-enter the x64 Wine loader through the pinned AoE-aware helper. */
+static void aoe_exec_sidecar(const char *sidecar, const char *loader, int argc, char **argv)
+{
+    char **args;
+    unsigned int i;
+    args=calloc(argc+3,sizeof(*args));
+    if (!args) fatal_error("cannot allocate software fault launch arguments\n");
+    args[0]=(char *)sidecar;args[1]="--cooperative";args[2]=(char *)loader;
+    for(i=1;i<argc;i++)args[i+2]=argv[i];
+    /* The sidecar exec discards Wine preloader reservations. Re-enter the
+     * normal preloader before server initialization, including Steam children. */
+    unsetenv("WINELOADERNOEXEC");
+    execv(sidecar,args);
+    fatal_error("cannot launch software fault translator: %s\n",strerror(errno));
+}
+
+static void aoe_reexec_sidecar(int argc, char **argv)
+{
+    const char *sidecar=getenv("AOELAB_SIDECAR_PATH"),*loader=getenv("WINELOADER");
+    if (argc<2 || !aoe_game_name(argv[1]) || !getenv("AOELAB_SOFTFAULT_GAME")) return;
+    if (aoe_bootstrap_is_current(getenv("X87_SIDECAR_BOOTSTRAP"))) return;
+    unsetenv("X87_SIDECAR_BOOTSTRAP");
+    if (!aoe_rosetta_supported()) fatal_error("AoE IV softfault hook requires Rosetta on macOS 26+\n");
+    if (!sidecar || sidecar[0]!='/' || access(sidecar,X_OK))
+        fatal_error("AoE IV softfault helper must be an absolute executable path\n");
+    if (!loader || loader[0]!='/' || access(loader,X_OK))
+        fatal_error("AoE IV WINELOADER must be an absolute executable path\n");
+    setenv("AOELAB_SOFTFAULT_BRIDGE","1",1);
+    setenv("AOE_SOFTFAULT_PC","0x140001000",1);
+    setenv("AOE_SOFTFAULT_END","0x1456ddadc",1);
+    setenv("AOE_SOFTFAULT_TARGET1","0x180000000",1);
+    setenv("AOE_SOFTFAULT_TARGET","0x180000010",1);
+    setenv("X87_ALWAYS_NONE","1",1);
+    aoe_exec_sidecar(sidecar,loader,argc,argv);
+}
+
+static void aoe_clear_child_profile(int argc, char **argv)
+{
+    static const char *const names[] = { "AOELAB_SOFTFAULT_BRIDGE", "AOE_SOFTFAULT_PC",
+        "AOE_SOFTFAULT_END", "AOE_SOFTFAULT_TARGET1", "AOE_SOFTFAULT_TARGET", "X87_ALWAYS_NONE" };
+    unsigned int i;
+    if (!getenv("AOELAB_SOFTFAULT_BRIDGE") || (argc>1 && aoe_game_name(argv[1]))) return;
+    for (i=0; i<ARRAY_SIZE(names); i++) unsetenv(names[i]);
+}
+
+#endif
