@@ -133,6 +133,85 @@ static NTSTATUS virtual_unwind( ULONG type, DISPATCHER_CONTEXT *dispatch, CONTEX
 /***********************************************************************
  *		RtlCaptureContext (NTDLL.@)
  */
+/* Opt-in software delivery thunk; installed only in the isolated soft engine. */
+void DECLSPEC_NORETURN aoe_soft_dispatch(ULONG64 *r, BYTE *xs, ULONG fault_length) {
+ BYTE storage[4096];ULONG avx_len=0;CONTEXT *c;CONTEXT_EX *ex;EXCEPTION_RECORD rec={0};ULONG64 mask;void *avx;NTSTATUS status;
+ memset(storage,0,sizeof(storage));
+ status=RtlInitializeExtendedContext2(storage,CONTEXT_ALL|CONTEXT_XSTATE,&ex,7);
+ if(status)RtlRaiseStatus(status);
+ c=RtlLocateLegacyContext(ex,NULL);
+ status=WINE_UNIX_CALL(unix_aoe_exception_context,c);
+ if(status)RtlRaiseStatus(status);
+ c->ContextFlags=CONTEXT_ALL|CONTEXT_XSTATE;
+ c->R15=r[0];c->R14=r[1];c->R13=r[2];c->R12=r[3];c->R11=r[4];c->R10=r[5];c->R9=r[6];c->R8=r[7];c->Rdi=r[8];c->Rsi=r[9];c->Rbp=r[10];c->Rbx=r[11];c->Rdx=r[12];c->Rcx=r[13];c->Rax=r[14];c->EFlags=(DWORD)r[15];c->Rip=r[16]-fault_length;c->Rsp=(ULONG64)(r+17);
+ memcpy(&c->FltSave,xs,512);memcpy(&c->MxCsr,xs+24,4);
+ avx=RtlLocateExtendedFeature(ex,2,&avx_len);if(!avx||avx_len!=256)RtlRaiseStatus(STATUS_INVALID_PARAMETER);
+ memcpy(&mask,xs+512,8);if(mask&4)memcpy(avx,xs+576,256);else memset(avx,0,256);
+ RtlSetExtendedFeaturesMask(ex,7);
+ rec.ExceptionCode=EXCEPTION_ILLEGAL_INSTRUCTION;rec.ExceptionAddress=(void *)c->Rip;
+ status=NtRaiseException(&rec,c,TRUE);for (;;) RtlRaiseStatus(status);
+}
+
