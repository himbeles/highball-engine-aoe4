+        ERR("Unsupported RelicCardinal.exe build: AoE IV experimental patches refused (SHA256 mismatch)\n");
+        return STATUS_INVALID_IMAGE_HASH;
+    }
+    aoe_game_verified = TRUE;
+    return STATUS_SUCCESS;
